00370 {\cf20 // ===== Speed Sliders =====}\par
00371 {\cf18 void} create_speed_sliders(lv_obj_t *parent)\par
00372 \{\par
00373   {\cf17 const} {\cf18 char} *labels[] = \{{\cf22 "FR"}, {\cf22 "FL"}, {\cf22 "RR"}, {\cf22 "RL"}\};\par
00374   {\cf18 int} y_positions[] = \{20, 60, 100, 140\};\par
00375 \par
00376   {\cf19 for} ({\cf18 int} i = 0; i < 4; i++)\par
00377   \{\par
00378     {\cf20 // Create label}\par
00379     lv_obj_t *label = lv_label_create(parent);\par
00380     lv_label_set_text(label, labels[i]);\par
00381     lv_obj_align(label, LV_ALIGN_TOP_RIGHT, -230, y_positions[i]);\par
00382 \par
00383     {\cf20 // Create slider}\par
00384     lv_obj_t *slider = lv_slider_create(parent);\par
00385     lv_slider_set_range(slider, 0, 255);\par
00386     lv_obj_set_size(slider, 150, 20);\par
00387     lv_obj_align_to(slider, label, LV_ALIGN_OUT_RIGHT_MID, 15, 0);\par
00388 \par
00389     {\cf20 // Create value label}\par
00390     lv_obj_t *value_label = lv_label_create(parent);\par
00391     {\cf18 char} buf[4];\par
00392     snprintf(buf, {\cf17 sizeof}(buf), {\cf22 "%d"}, lv_slider_get_value(slider));\par
00393     lv_label_set_text(value_label, buf);\par
00394     lv_obj_align_to(value_label, slider, LV_ALIGN_OUT_RIGHT_MID, 15, 0);\par
00395 \par
00396     {\cf20 // Add event callback that updates the value label}\par
00397     lv_obj_add_event_cb(\par
00398         slider, [](lv_event_t *e)\par
00399         \{\par
00400                 lv_obj_t* s = (lv_obj_t*)lv_event_get_target(e);\par
00401                 lv_obj_t* val_lbl = (lv_obj_t*)lv_event_get_user_data(e);\par
00402                 {\cf18 char} buf[4]; {\cf20 // Buffer to hold the string representation of the slider value (3 digits + null terminator)}\par
00403                 snprintf(buf, {\cf17 sizeof}(buf), {\cf22 "%d"}, lv_slider_get_value(s));\par
00404                 lv_label_set_text(val_lbl, buf); \},\par
00405         LV_EVENT_VALUE_CHANGED, value_label);\par
00406 \par
00407     {\cf20 // Add slider event callback to update speed}\par
00408     lv_obj_add_event_cb(slider, slider_event_cb, LV_EVENT_VALUE_CHANGED, ({\cf18 void} *)labels[i]);\par
00409   \}\par
00410 \}\par
