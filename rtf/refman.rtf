00156 {\cf17 static} {\cf18 void} main_btnm_event_cb(lv_event_t *e)\par
00157 \{\par
00158   lv_obj_t *btnm = (lv_obj_t *)lv_event_get_target(e);\par
00159   {\cf17 const} {\cf18 char} *dir_txt = lv_btnmatrix_get_btn_text(\par
00160       btnm, lv_btnmatrix_get_selected_btn(btnm));\par
00161 \par
00162   {\cf19 if} (dir_txt == NULL)\par
00163     {\cf19 return};\par
00164 \par
00165   {\cf19 if} (strcmp(dir_txt, {\cf22 "Forward"}) == 0 || strcmp(dir_txt, {\cf22 "Backward"}) == 0)\par
00166   \{\par
00167     apply_mode({\cf22 "Straight"}, dir_txt);\par
00168   \}\par
00169   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "Left"}) == 0 || strcmp(dir_txt, {\cf22 "Right"}) == 0)\par
00170   \{\par
00171     apply_mode({\cf22 "Sideways"}, dir_txt);\par
00172   \}\par
00173   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "45"}) == 0 || strcmp(dir_txt, {\cf22 "135"}) == 0 || strcmp(dir_txt, {\cf22 "225"}) == 0 || strcmp(dir_txt, {\cf22 "315"}) == 0)\par
00174   \{\par
00175     apply_mode({\cf22 "Diagonal"}, dir_txt);\par
00176   \}\par
00177   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "Right Fwd"}) == 0 || strcmp(dir_txt, {\cf22 "Right Bwd"}) == 0 || strcmp(dir_txt, {\cf22 "Left Fwd"}) == 0 || strcmp(dir_txt, {\cf22 "Left Bwd"}) == 0)\par
00178   \{\par
00179     apply_mode({\cf22 "Pivot"}, dir_txt);\par
00180   \}\par
00181   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "Front Right"}) == 0 || strcmp(dir_txt, {\cf22 "Front Left"}) == 0 || strcmp(dir_txt, {\cf22 "Rear Right"}) == 0 || strcmp(dir_txt, {\cf22 "Rear Left"}) == 0)\par
00182   \{\par
00183     apply_mode({\cf22 "Pivot Sideways"}, dir_txt);\par
00184   \}\par
00185   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "CCW"}) == 0 || strcmp(dir_txt, {\cf22 "CW"}) == 0)\par
00186   \{\par
00187     apply_mode({\cf22 "Rotate"}, dir_txt);\par
00188   \}\par
00189   {\cf19 else} {\cf19 if} (strcmp(dir_txt, {\cf22 "Prgm Car"}) == 0)\par
00190   \{\par
00191     btn_Run_Program_event_cb(e);\par
00192   \}\par
00193 \}\par
